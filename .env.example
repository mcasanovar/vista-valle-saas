# Copy to .env.local only for local development or CI verification.
# Every value below is a non-production mock. Replace all of them before a production deployment.
# Production rejects mock/placeholder credentials unless this explicit mock context is selected.
VISTA_VALLE_CONFIG_CONTEXT=mock
NEXT_PUBLIC_VISTA_VALLE_CONFIG_CONTEXT=mock

# Browser-safe Supabase configuration (required; public by design; mock values)
NEXT_PUBLIC_SUPABASE_URL=https://mock-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=mock-supabase-anon-key

# Server-only Supabase and PostgreSQL configuration (required; mock values)
SUPABASE_SERVICE_ROLE_KEY=mock-supabase-service-role-key
DATABASE_URL=postgresql://mock_user:mock_password@localhost:5432/mock_vista_valle?sslmode=disable

# Server-only Fintoc configuration (required; mock values)
FINTOC_API_KEY=mock-fintoc-api-key
FINTOC_WEBHOOK_SECRET=mock-fintoc-webhook-secret

# Server-only Mercado Pago configuration (required; mock values)
MERCADO_PAGO_ACCESS_TOKEN=mock-mercado-pago-access-token
MERCADO_PAGO_WEBHOOK_SECRET=mock-mercado-pago-webhook-secret

# Provider-independent AI configuration (required; mock values)
AI_PROVIDER=mock-ai-provider
AI_MODEL=mock-ai-model
AI_API_KEY=mock-ai-api-key

# Server-only transactional email configuration (required; mock values)
RESEND_API_KEY=mock-resend-api-key
RESEND_DELIVERY_MODE=mock
RESEND_FROM_EMAIL=reservas@vistavalle.cl
# Display name shown next to RESEND_FROM_EMAIL, e.g. "Name <email>". Change
# both together to send from a domain you control while testing, then switch
# back to the values above for production - no code change required.
RESEND_FROM_NAME=Vista Valle SpA
OUTBOX_PROCESSOR_SECRET=mock-outbox-processor-secret-000000
# In Vercel, configure CRON_SECRET with exactly the same production value as
# OUTBOX_PROCESSOR_SECRET so its scheduled GET request is authorized.
CRON_SECRET=mock-outbox-processor-secret-000000
ADMIN_NOTIFICATION_EMAIL=admin@example.test

# Server-only administrative authorization (mock fixture only)
ADMIN_ALLOWED_EMAILS=mock-admin@example.test

# Site and lodging time configuration (required; mock/non-commercial values)
SITE_URL=https://mock-vista-valle.example.test
TIMEZONE=America/Santiago

# Operational settings (mock/non-commercial verification values)
BOOKING_ENABLED=false
BOOKING_HOLD_DURATION_MINUTES=15
ASSISTANT_PROPOSAL_TTL_MINUTES=10
NOTIFICATION_MAX_RETRIES=3
