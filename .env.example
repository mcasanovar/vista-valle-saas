# Copy to .env.local, replacing every REPLACE_WITH_* placeholder below with a
# real credential before deploying. The default context here is production:
# a copy of this file with placeholders left in place fails to start instead
# of silently granting a full administrative session with no credentials
# (harden-admin-authentication, task 3.2 - see src/config/server.ts for the
# assertion that enforces this).
#
# For local development against the deterministic mock stack instead, copy
# .env.test.example (not this file) to .env.local.
VISTA_VALLE_CONFIG_CONTEXT=production
NEXT_PUBLIC_VISTA_VALLE_CONFIG_CONTEXT=production

# Browser-safe Supabase configuration (required; public by design)
NEXT_PUBLIC_SUPABASE_URL=REPLACE_WITH_SUPABASE_PROJECT_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY

# Server-only PostgreSQL configuration (required)
DATABASE_URL=postgresql://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@REPLACE_WITH_HOST:5432/REPLACE_WITH_DATABASE
# SUPABASE_SERVICE_ROLE_KEY is deliberately absent here (harden-admin-
# authentication, task 13.1): no runtime route uses it, it bypasses both
# row-level security and authentication, and the app starts without it.
# Only scripts/load-room-content.mjs and scripts/migrate-room-images-to-
# cloudinary.mjs need it, read straight from the local shell environment
# that runs them - never set it in a deployment's environment.

# Server-only Cloudinary configuration for room photos (required)
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_CLOUDINARY_API_SECRET

# Server-only Fintoc configuration (required)
FINTOC_API_KEY=REPLACE_WITH_FINTOC_API_KEY
FINTOC_WEBHOOK_SECRET=REPLACE_WITH_FINTOC_WEBHOOK_SECRET

# Server-only Mercado Pago configuration (required)
MERCADO_PAGO_ACCESS_TOKEN=REPLACE_WITH_MERCADO_PAGO_ACCESS_TOKEN
MERCADO_PAGO_WEBHOOK_SECRET=REPLACE_WITH_MERCADO_PAGO_WEBHOOK_SECRET

# Provider-independent AI configuration (required)
AI_PROVIDER=REPLACE_WITH_AI_PROVIDER
AI_MODEL=REPLACE_WITH_AI_MODEL
AI_API_KEY=REPLACE_WITH_AI_API_KEY
# Speech-to-text model for the admin assistant's voice input; a separate
# model name from AI_MODEL even on the same provider (design.md decision 7).
AI_TRANSCRIPTION_MODEL=REPLACE_WITH_AI_TRANSCRIPTION_MODEL

# Server-only transactional email configuration (required)
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
RESEND_DELIVERY_MODE=real
RESEND_FROM_EMAIL=reservas@vistavalle.cl
# Display name shown next to RESEND_FROM_EMAIL, e.g. "Name <email>".
RESEND_FROM_NAME=Vista Valle SpA
OUTBOX_PROCESSOR_SECRET=REPLACE_WITH_OUTBOX_PROCESSOR_SECRET_32_CHARS_MIN
# In Vercel, configure CRON_SECRET with exactly the same production value as
# OUTBOX_PROCESSOR_SECRET so its scheduled GET request is authorized.
CRON_SECRET=REPLACE_WITH_OUTBOX_PROCESSOR_SECRET_32_CHARS_MIN
# Required in production for the scheduled Airbnb/Booking iCal poller. Use
# the same value as CRON_SECRET because Vercel sends that value as Bearer auth.
CHANNEL_SYNC_PROCESSOR_SECRET=REPLACE_WITH_OUTBOX_PROCESSOR_SECRET_32_CHARS_MIN
ADMIN_NOTIFICATION_EMAIL=REPLACE_WITH_ADMIN_NOTIFICATION_EMAIL

# Server-only administrative authorization - real production identity, never
# a placeholder: see harden-admin-authentication for why this value must
# never be committed with a real address either.
ADMIN_ALLOWED_EMAILS=REPLACE_WITH_ADMIN_EMAIL
# The Supabase "User UID" for that same account (Authentication -> Users).
# Required jointly with ADMIN_ALLOWED_EMAILS - see src/infrastructure/auth/authorization.ts.
ADMIN_ALLOWED_USER_IDS=REPLACE_WITH_ADMIN_USER_UUID

# Site and lodging time configuration (required)
SITE_URL=https://vistavalle.cl
TIMEZONE=America/Santiago

# Operational settings
BOOKING_ENABLED=true
BOOKING_HOLD_DURATION_MINUTES=15
# Kill switch for the admin assistant page; off until credentials and a
# provider spend limit are configured (design.md decision 11).
ASSISTANT_ENABLED=false
ASSISTANT_PROPOSAL_TTL_MINUTES=10
NOTIFICATION_MAX_RETRIES=3
